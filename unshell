#!/bin/env bash

ulimit -s unlimited >/dev/null 2>&1

show_usage() {
	printf "%s - Deobfuscate any shell scripts with multiple methods\n  Usage: %s [OPTIONS] [FILE]\n  Usage: %s [OPTIONS] [DIR]\n\n  Options:\n    -h, --help\n      print this message\n    -f, --file [FILE]\n      Scripts you wanted to deobfuscate, multi input is supported\n    -r, --recursive [DIR]\n      Recursively find and deobfuscate all files in the specified directory\n    -v, --verbose\n      Be verbose\n    -d, --execve-delay [SECOND]\n      Set custom execve delay time in seconds for SHC encryption (not used for SSC)\n    -U, --update\n      Update the script\n\n  Example usages:\n    %s -f install.sh menu.sh\n    %s -v -f /system/bin/gaming_script\n    %s -d 6.018 -f ./VTK\n    %s -r .\n    \n" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}"\n	exit 0
}

update_script() {
	temp="$HOME/unshell.temp"
	which_is_unshell=$(which unshell)

	if [ -z "$which_is_unshell" ]; then
		echo "'which' is not installed, please install it!"
		exit 1
	fi

	# Download the latest version
	if ! curl -Lo "$temp" https://github.com/hoshiyomiX/unshell/raw/testing/unshell; then
		rm -f "$temp"
		echo "error: failed to download update script"
		exit 1
	fi

	# Ensure the current binary is removed only after successful download
	if rm -f "$which_is_unshell" && mv "$temp" "$which_is_unshell"; then
		chmod +x "$which_is_unshell"
		echo "Updated successfully"
		exit 0
	else
		echo "error: failed to update"
		exit 1
	fi
}

remove_comments() {
	if ! hash shfmt; then
		echo "error: environment has missing dependencies"
		return 127
	fi
	shfmt -mn ./$filename.temp1.sh >./$filename.temp2.sh
	mv ./$filename.temp2.sh ./$filename.temp1.sh
}

decrypt_ricrypt() {
	if ! hash strace; then
		echo "error: environment has missing dependencies"
		return 127
	fi
	spath=$(echo $PATH | cut -d: -f1)
	cp ./$filename.temp1.sh $spath/$filename.temp1.sh
	chmod +x $spath/$filename.temp1.sh

	strace -s 50000 -f -e trace=execve $filename.temp1.sh 2>&1 |
		while read -r line; do
			if echo "$line" | grep -q "eval"; then
				pkill $filename.temp1.sh
				echo $line | grep -oP 'eval.*?"\K[^"]+' | tr -d '\' 2>/dev/null | base64 -d >./$filename.temp2.sh
				break
			fi
		done

	rm -f $spath/$filename.temp1.sh
	if [ -s ./$filename.temp2.sh ]; then
		mv ./$filename.temp2.sh ./$filename.temp1.sh
	else
		rm ./$filename.temp2.sh ./$filename.temp1.sh
	fi
}

decrypt_ssc() {
	if ! hash strace timeout; then
		echo "error: environment has missing dependencies (strace, timeout)"
		return 127
	fi
	
	spath=$(echo $PATH | cut -d: -f1)
	cp ./$filename.temp1.sh $spath/$filename.temp1.sh
	chmod +x $spath/$filename.temp1.sh

	# Use strace to capture write syscalls with full data
	# SSC writes decrypted script to pipe, which we intercept
	timeout 15s strace -s 999999 -e trace=write -f $filename.temp1.sh 2>&1 | \
	grep -a 'write([0-9]' | \
	awk '{
		# Extract content between quotes after write(fd, 
		match($0, /write\([0-9]+, "(.*)"/, arr)
		if (arr[1] != "") {
			printf "%s", arr[1]
		}
	}' | \
	sed 's/\\n/\n/g; s/\\t/\t/g; s/\\"/"/g; s/\\\\/\\/g' > "./$filename.temp2.sh"

	rm -f $spath/$filename.temp1.sh
	
	if [ -s ./$filename.temp2.sh ]; then
		# Verify we captured a valid shell script
		if grep -q '^#!/' "./$filename.temp2.sh" || head -n1 "./$filename.temp2.sh" | grep -qE '^[[:space:]]*(#|[a-zA-Z])'; then
			mv ./$filename.temp2.sh ./$filename.temp1.sh
		else
			echo "notice: Captured data doesn't look like a shell script, attempting cleanup..."
			# Try to extract script starting from shebang
			if grep -q '#!' "./$filename.temp2.sh"; then
				sed -n '/#!/,$p' "./$filename.temp2.sh" > "./$filename.temp3.sh"
				if [ -s ./$filename.temp3.sh ]; then
					mv ./$filename.temp3.sh ./$filename.temp1.sh
					rm -f ./$filename.temp2.sh
				else
					rm -f ./$filename.temp2.sh ./$filename.temp3.sh ./$filename.temp1.sh
					echo "error: Failed to extract valid script from SSC binary"
					return 1
				fi
			else
				rm -f ./$filename.temp2.sh ./$filename.temp1.sh
				echo "error: No shebang found in captured data"
				return 1
			fi
		fi
	else
		rm -f ./$filename.temp2.sh ./$filename.temp1.sh
		echo "error: Failed to capture script from SSC binary (possibly protected with -u flag or segmented with -S)"
		return 1
	fi
}

decrypt_shc() {
	spath=$(echo $PATH | cut -d: -f1)
	cp ./$filename.temp1.sh $spath/$filename.temp1.sh
	chmod +x $spath/$filename.temp1.sh

	if [ -z $EXECVE_DELAY ]; then
		for sec in {1..7}; do
			$filename.temp1.sh &
			child=$!
			sleep 0.0"$sec"
			kill -STOP $child
			cat /proc/$child/cmdline | sed 's/.*\(#!\)/\1/' >"./$filename.temp2.sh"
			kill -TERM $child

			if grep -q '#!/' "./$filename.temp2.sh"; then
				break
			fi
		done
	else
		$filename.temp1.sh &
		child=$!
		sleep $EXECVE_DELAY
		kill -STOP $child
		cat /proc/$child/cmdline | sed 's/.*\(#!\)/\1/' >"./$filename.temp2.sh"
		kill -TERM $child
	fi

	rm -f $spath/$filename.temp1.sh
	if grep -q '#!/' "./$filename.temp2.sh"; then
		mv ./$filename.temp2.sh ./$filename.temp1.sh
	else
		rm ./$filename.temp2.sh ./$filename.temp1.sh
	fi
}

decrypt_bashrock() {
	sed 's/eval "$x";/echo "$x";/g' ./$filename.temp1.sh >./$filename.temp2.sh
	bash ./$filename.temp2.sh >./$filename.temp1.sh
	rm ./$filename.temp2.sh
}

decrypt_bashprotector() {
	sed 's/\beval\b/echo/g' ./$filename.temp1.sh >./$filename.temp2.sh
	bash ./$filename.temp2.sh | bash >./$filename.temp1.sh
	rm ./$filename.temp2.sh
}

decrypt_bashobsf() {
	sed 's/eval "\$/echo "\$/g; s/\[ "$(id -u)" -ne 2000 \]/! true/' ./$filename.temp1.sh >./$filename.temp2.sh
	bash ./$filename.temp2.sh >./$filename.temp1.sh
	rm ./$filename.temp2.sh
}

decrypt_tpp() {
	if ! hash shfmt; then
		echo "error: environment has missing dependencies"
		return 127
	fi
	shfmt -mn -w ./$filename.temp1.sh
	sed '/<<EOF/,/EOF/d' ./$filename.temp1.sh >./$filename.temp2.sh
	mv ./$filename.temp2.sh ./$filename.temp1.sh
	sed 's/eval "\$/echo "\$/g' ./$filename.temp1.sh >./$filename.temp2.sh
	bash ./$filename.temp2.sh >./$filename.temp1.sh
	rm ./$filename.temp2.sh
}

decrypt_base64() {
	sed 's/base64 -d | [a-z\/]*sh/base64 -d/; s/\[ "$(id -u)" -ne 2000 \]/! true/' ./$filename.temp1.sh >./$filename.temp2.sh
	bash ./$filename.temp2.sh >./$filename.temp1.sh
	rm ./$filename.temp2.sh
}

decrypt_bzip2() {
	skip=$(($(sed -n 2p ./$filename.temp1.sh | awk -F'=' '{print $2}') - 1))
	sed 1,${skip}d ./$filename.temp1.sh >./$filename.temp2.sh
	bzip2 -cd ./$filename.temp2.sh >./$filename.temp1.sh
	rm ./$filename.temp2.sh
}

decrypt_axeron() {
	cat <<"EOF" >./temp_functions.sh
rozaq() {
	if [ "$1" = "-d" ] && [ -n "$2" ]; then
		[[ "${2:0:3}" = "r17" ]] && echo "${2:3}" | tr R-ZA-Qr-za-q A-Za-z | base64 -d || echo "$2"
	else
		echo "r17$(echo -n "$1" | base64 | tr A-Za-z R-ZA-Qr-za-q)"
	fi
}

storm() {
	obsf_link=$(echo $2)
	rozaq -d $obsf_link
}
EOF

	REP_FUNCTION="./temp_functions.sh"
	sed "s|source \$FUNCTION|source $REP_FUNCTION|; s/\[ \"\$(id -u)\" -ne 2000 \]/! true/" ./$filename.temp1.sh >./$filename.temp2.sh
	obsf_link=$(bash ./$filename.temp2.sh)
	echo "Obfuscated link: $obsf_link"
	echo "Downloading script..."
	rm $REP_FUNCTION
	curl -Lo ./$filename.temp1.sh $obsf_link
	# Don't use '||' here, just don't
	[ $? -gt 0 ] && rm ./$filename.temp1.sh && echo "error: unable to download axeron script." && return 1
}

decrypt_eval_base64() {
	sed 's/eval "\$/echo "\$/g; s/\[ "$(id -u)" -ne 2000 \]/! true/' ./$filename.temp1.sh >./$filename.temp2.sh
	bash ./$filename.temp2.sh >./$filename.temp1.sh
	rm ./$filename.temp2.sh
}

