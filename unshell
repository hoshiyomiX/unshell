decrypt_kaminarienc() {
        _random=$(tr -dc 'A-Za-z0-9' < /dev/random | head -c 30)
	chmod +x $filename.temp1.sh

    # patch
	sed -i "s|/data/local/tmp/.cache_script.sh|./$_random|g" \
	   $filename.temp1.sh

    ./$filename.temp1.sh & child=$!
	cat ./$_random >"./$filename.temp2.sh"
	kill -TERM $child

	rm -f ./$_random

	if [ $(wc -c <"./$filename.temp2.sh") -gt 1 ]; then
		mv ./$filename.temp2.sh ./$filename.temp1.sh
	else
		rm ./$filename.temp2.sh ./$filename.temp1.sh
	fi
}

# Generic handler for unknown ELF binaries that look like shell script wrappers
decrypt_generic_binary() {
	if ! hash strace timeout file; then
		echo "error: environment has missing dependencies (strace, timeout, file)"
		return 127
	fi
	
	echo "notice: Attempting generic binary deobfuscation (stripped/unknown compiler)..."
	
	spath=$(echo $PATH | cut -d: -f1)
	cp ./$filename.temp1.sh $spath/$filename.temp1.sh
	chmod +x $spath/$filename.temp1.sh

	# Try multiple methods in order of likelihood
	
	# Method 1: Capture write() syscalls (SSC-style)
	timeout 15s strace -s 999999 -e trace=write -f $filename.temp1.sh 2>&1 | \
	grep -a 'write([0-9]' | \
	awk '{
		match($0, /write\([0-9]+, "(.*)"/, arr)
		if (arr[1] != "") {
			printf "%s", arr[1]
		}
	}' | \
	sed 's/\\n/\n/g; s/\\t/\t/g; s/\\"/"/g; s/\\\\/\\/g' > "./$filename.temp2.sh"

	# Check if we got a valid script
	if [ -s ./$filename.temp2.sh ] && (grep -q '^#!/' "./$filename.temp2.sh" || head -n1 "./$filename.temp2.sh" | grep -qE '^[[:space:]]*(#|[a-zA-Z])'); then
		echo "success: Captured script via write() syscalls"
		rm -f $spath/$filename.temp1.sh
		mv ./$filename.temp2.sh ./$filename.temp1.sh
		return 0
	fi
	
	# Method 2: Try execve capture (SHC-style)
	echo "notice: Trying execve() capture method..."
	rm -f ./$filename.temp2.sh
	
	if [ -z $EXECVE_DELAY ]; then
		for sec in {1..7}; do
			$filename.temp1.sh &
			child=$!
			sleep 0.0"$sec"
			kill -STOP $child 2>/dev/null
			cat /proc/$child/cmdline 2>/dev/null | sed 's/.*\(#!\)/\1/' >"./$filename.temp2.sh"
			kill -TERM $child 2>/dev/null

			if grep -q '#!/' "./$filename.temp2.sh"; then
				echo "success: Captured script via execve() at delay 0.0${sec}s"
				rm -f $spath/$filename.temp1.sh
				mv ./$filename.temp2.sh ./$filename.temp1.sh
				return 0
			fi
		done
	fi

	# Cleanup if all methods failed
	rm -f $spath/$filename.temp1.sh ./$filename.temp2.sh ./$filename.temp1.sh
	echo "error: Failed to deobfuscate binary with generic methods"
	return 1
}

init_dec() {
	[ $VERBOSE -eq 1 ] && set -x
	while true; do
		if [ ! -f ./$filename.temp1.sh ]; then
			break
		elif grep -q '$RzE' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: bashrock"
			decrypt_bashrock
			PASSED_LOOP=1
		elif grep -q 'Tx=Eds' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: bashprotector"
			decrypt_bashprotector
			PASSED_LOOP=1
		elif grep -q 'z=.*;.*z=.*;' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: bash-obfuscate"
			decrypt_bashobsf
			PASSED_LOOP=1
		elif grep -q 'dec_.*=$(echo\s"$enc"' ./$filename.temp1.sh && ! grep -q 'while\sread' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: TPP Tool"
			decrypt_tpp
			PASSED_LOOP=1
		elif grep -q "Strong_Encryptor_By_BOYZGAMES" ./$filename.temp1.sh && ! grep -q 'ro.serialno' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: Strong_Encryptor_By_BOYZGAMES (base64)"
			decrypt_eval_base64
			PASSED_LOOP=1
		elif grep -q 'storm\s-x' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: Axeron online module"
			decrypt_axeron
			PASSED_LOOP=1
		elif grep -q '/bin/bzip2\s-cd' ./$filename.temp1.sh && grep -q 'skip=23' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: bzip2"
			decrypt_bzip2
			PASSED_LOOP=1
		elif grep -q 'base64 -d | [a-z\/]*sh$' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: base64"
			decrypt_base64
			PASSED_LOOP=1
		elif grep -q 'modul putraxitersz' ./$filename.temp1.sh; then
			counter=$((counter + 1))
			echo "Layer $counter: putraxitersz"
			decrypt_putraxitersz
			PASSED_LOOP=1
		elif [ $(grep -c '^#' ./$filename.temp1.sh) -gt 180 ]; then
			counter=$((counter + 1))
			echo "Layer $counter: Extreme comment/editor EOF trick"
			remove_comments
			PASSED_LOOP=1
		elif strings ./$filename.temp1.sh | grep -q 'SSC_ARGV0'; then
			counter=$((counter + 1))
			echo "Layer $counter: SSC (Simple Script Compiler)"
			decrypt_ssc
			PASSED_LOOP=1
		elif strings ./$filename.temp1.sh | grep -q 'E:\sneither\sargv\[0\]\snor\s\$_\sworks\.'; then
			counter=$((counter + 1))
			echo "Layer $counter: shc"
			decrypt_shc
			PASSED_LOOP=1
		elif strings ./$filename.temp1.sh | grep -q 'sh-cFailed'; then
			counter=$((counter + 1))
			echo "Layer $counter: Ri-crypt"
			decrypt_ricrypt
			PASSED_LOOP=1
		elif strings ./$filename.temp1.sh | grep -q "/data/local/tmp/.cache_script.sh"; then
			counter=$((counter + 1))
			echo "Layer $counter: Kaminari-enc"
			decrypt_kaminarienc
			PASSED_LOOP=1
		# Fallback: Check if it's an ELF binary with shell script wrapper characteristics
		elif [ $PASSED_LOOP -eq 0 ] && file ./$filename.temp1.sh 2>/dev/null | grep -qE 'ELF.*executable'; then
			# Check if binary has shell script wrapper indicators
			if strings ./$filename.temp1.sh | grep -qE 'pipe2|fork|execvp|environ'; then
				counter=$((counter + 1))
				echo "Layer $counter: Generic binary (stripped/unknown compiler)"
				decrypt_generic_binary
				PASSED_LOOP=1
			else
				rm ./$filename.temp1.sh
				echo "error: ELF binary detected but doesn't appear to be a shell script wrapper"
				break
			fi
		else
			[ $PASSED_LOOP -eq 0 ] && rm ./$filename.temp1.sh && echo "error: unknown patterns, deobfuscation is not supported."
			break
		fi
	done

	if [ ! -s ./$filename.temp1.sh ]; then
		[ $VERBOSE -eq 1 ] && set +x
		echo "Failed to deobfuscate $1"
		remove_temp
		return 1
	fi

	[ $VERBOSE -eq 1 ] && set +x
	# Move to output directory in the input file's location
	mv ./$filename.temp1.sh "$output_dir/$filename.dec.sh"
	echo "$output_dir/$filename.dec.sh unshelled"
	remove_temp
}

remove_temp() {
	rm -f ./$filename.temp*.sh
	counter=0
}

process_files() {
	for file in "$@"; do
		if [ ! -f "$file" ]; then
			echo "error: file $file does not exist!"
		else
			PASSED_LOOP=0
			filename=$(basename "$file")
			
			# Get the directory of the input file
			file_dir=$(dirname "$(realpath "$file")")
			
			# Create output directory in the input file's location
			output_dir="$file_dir/output"
			mkdir -p "$output_dir"
			
			cp "$file" "./$filename.temp1.sh"
			echo "Deobfuscating $file -> $output_dir/$filename.dec.sh"
			init_dec "$file"
		fi
	done
}

process_recursive() {
	# Get the directory path and create output folder
	dir_path=$(realpath "$1")
	output_dir="$dir_path/output"
	mkdir -p "$output_dir"
	
	find "$1" -maxdepth 1 -type f | while IFS= read -r file; do
		process_files "$file"
	done
}

if ! hash strings curl; then
	echo "error: environment has missing dependencies"
	exit 1
fi

RECURSIVE=0
FILES=0
VERBOSE=0

while [[ $# -gt 0 ]]; do
	case $1 in
	-h | --help)
		show_usage
		exit 0
		;;
	-v | --verbose)
		VERBOSE=1
		shift
		;;
	-d | --execve-delay)
		shift
		if [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
			EXECVE_DELAY=$1
		else
			echo -e "error: execve delay MUST be a positive integer or decimal number!\nFor help, type: 'unshell --help'."
			exit 1
		fi
		shift
		;;
	-U | --update)
		update_script
		shift
		;;
	-r | --recursive)
		RECURSIVE=1
		shift
		break
		;;
	-f | --file)
		FILES=1
		shift
		break
		;;
	-*)
		echo -e "error: bad option\nFor help, type: 'unshell --help'."
		exit 1
		;;
	*) shift ;;
	esac
done

if [[ "$RECURSIVE" -eq 1 && "$FILES" -eq 1 ]]; then
	echo -e "error: -r and -f option cannot coexist!\nFor help, type: 'unshell --help'."
	exit 1
elif [[ "$RECURSIVE" -eq 0 && "$FILES" -eq 0 ]]; then
	echo -e "error: the following arguments are required: -f, --file or -r, --recursive\nFor help, type: 'unshell --help'."
	exit 1
fi

if [ -z "$1" ]; then
	echo -e "error: no input file or directory\nFor help, type: 'unshell --help'."
	exit 1
fi

if [ "$RECURSIVE" -eq 1 ]; then
	for dir in "$@"; do
		if [ -d "$dir" ]; then
			process_recursive "$dir"
		else
			echo "error: $dir is not a directory!"
		fi
	done
else
	process_files "$@"
fi
